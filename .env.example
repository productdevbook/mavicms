# Used by docker-compose.yml. Copy to .env and adjust as needed.

# --- Bundled Postgres (default) ---
POSTGRES_USER=mavicms
POSTGRES_PASSWORD=mavicms
POSTGRES_DB=mavicms

# --- Backend ---
# Defaults to the bundled Postgres above. Point this at your own Postgres,
# MySQL or SQLite instance instead and the "postgres" service can be removed
# from docker-compose.yml entirely.
DATABASE_URL=postgres://mavicms:mavicms@postgres:5432/mavicms
RUST_LOG=info

# --- Frontend (host ports) ---
FRONTEND_PORT=8081
BACKEND_PORT=8080
