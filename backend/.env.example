# Pick ONE of the following and set it as DATABASE_URL.
# Postgres:
# DATABASE_URL=postgres://user:password@localhost:5432/mavicms
# MySQL:
# DATABASE_URL=mysql://user:password@localhost:3306/mavicms
# SQLite (good for local dev, file created automatically):
DATABASE_URL=sqlite://data.db?mode=rwc

HOST=0.0.0.0
PORT=8080
RUST_LOG=info,mavicms_api=debug,sqlx=warn
